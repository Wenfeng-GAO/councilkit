{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["src", "shared", "tests/unit"],
  // Legacy gateway tests carry pre-existing type errors and are deleted in U7
  // (docs/plans/2026-07-17-001); they run under Vitest but stay outside the
  // default typecheck until removal.
  "exclude": [
    "tests/unit/settings-store.test.ts",
    "tests/unit/gateway-crypto-migrate.test.ts",
    "tests/unit/round-errors.test.ts"
  ]
}
