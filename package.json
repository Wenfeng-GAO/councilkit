{
  "name": "councilkit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Local-first rooms for multi-agent decisions.",
  "scripts": {
    "dev": "tsx runtime-host/main.ts",
    "dev:vite": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-host.mjs",
    "build:host": "node scripts/build-host.mjs",
    "start": "node dist-host/main.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.host.json",
    "lint": "biome check src shared runtime-host tests scripts playwright.config.ts",
    "format": "biome format --write src shared runtime-host tests scripts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:host": "vitest run tests/host",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "crypto-js": "^4.2.0",
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.2",
    "zod": "^4.4.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.2",
    "@playwright/test": "^1.61.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.21.5",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.23.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^1.6.0"
  }
}
