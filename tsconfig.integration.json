{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"],
      "@host/*": ["runtime-host/*"]
    }
  },
  // These two test files span the browser (@/) and host (@host) worlds in one
  // file; their transitive import graphs are checked from here. Neither the
  // app tsconfig (no @host) nor the host tsconfig (no @/) can cover them.
  "include": ["tests/integration/discussion-runtime.test.ts", "tests/smoke/live-runtime-smoke.ts"]
}
