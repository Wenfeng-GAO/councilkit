{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"],
      "@host/*": ["runtime-host/*"]
    }
  },
  "include": ["runtime-host", "shared", "tests/host", "tests/integration", "tests/fixtures", "tests/smoke"],
  // discussion-runtime.test.ts and live-runtime-smoke.ts span src (@/) + host
  // (@host); they are typechecked by tsconfig.integration.json instead.
  "exclude": [
    "tests/integration/discussion-runtime.test.ts",
    "tests/smoke/live-runtime-smoke.ts"
  ]
}
